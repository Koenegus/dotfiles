# Brightness Up
"backlight incr 5"
    XF86MonBrightnessUp

# Brightness Down
"backlight decr 5"
    XF86MonBrightnessDown

"/home/ivan/Scripts/audio_up.sh"
  XF86AudioRaiseVolume

"/home/ivan/Scripts/audio_down.sh"
  XF86AudioLowerVolume

