# Brightness Up
"backlight incr 5"
    XF86MonBrightnessUp

# Brightness Down
"backlight decr 5"
    XF86MonBrightnessDown

"/home/ivan/Scripts/audio_up.sh"
  XF86AudioRaiseVolume

"/home/ivan/Scripts/audio_down.sh"
  XF86AudioLowerVolume

"/home/ivan/Scripts/audio_mute.sh"
  XF86AudioMute

#bspwm
"bspc node -f west"
  Mod4 + Left
"bspc node -f south"
  Mod4 + Down
"bspc node -f north"
  Mod4 + Up
"bspc node -f east"
  Mod4 + Right
"bspc node -c"
  Mod4 + q

"bspc node -s west"
  Mod4 + Shift + Left
"bspc node -s south"
  Mod4 + Shift + Down
"bspc node -s north"
  Mod4 + Shift + Up
"bspc node -s east"
  Mod4 + Shift + Right

"bspc desktop -f ^1"
  Mod4 + 1
"bspc desktop -f ^2"
  Mod4 + 2
"bspc desktop -f ^3"
  Mod4 + 3
"bspc desktop -f ^4"
  Mod4 + 4
"bspc desktop -f ^5"
  Mod4 + 5
"bspc desktop -f ^6"
  Mod4 + 6
"bspc desktop -f ^7"
  Mod4 + 7
"bspc desktop -f ^8"
  Mod4 + 8
"bspc desktop -f ^9"
  Mod4 + 9

"bspc node -d ^1 --follow"
  Mod4 + Shift + 1
"bspc node -d ^2 --follow"
  Mod4 + Shift + 2
"bspc node -d ^3 --follow"
  Mod4 + Shift + 3
"bspc node -d ^4 --follow"
  Mod4 + Shift + 4
"bspc node -d ^5 --follow"
  Mod4 + Shift + 5
"bspc node -d ^6 --follow"
  Mod4 + Shift + 6
"bspc node -d ^7 --follow"
  Mod4 + Shift + 7
"bspc node -d ^8 --follow"
  Mod4 + Shift + 8
"bspc node -d ^9 --follow"
  Mod4 + Shift + 9

"bspc node -v -20 0"
  Mod4 + Mod1 + Left
"bspc node -v 0 20"
  Mod4 + Mod1 + Down
"bspc node -v 0 -20"
  Mod4 + Mod1 + Up
"bspc node -v 20 0"
  Mod4 + Mod1 + Right

"bspc node -g sticky"
  Mod4 + s
"bspc node -t floating"
  Mod4 + n
"bspc node -t tiled"
  Mod4 + t
"bspc node -t fullscreen"
  Mod4 + Shift + n
"bspc desktop -l next"
  Mod4 + m

"bspc wm -r"
  Mod4 + Shift + r 

"bspc node -z left -20 0 || bspc node -z right -20 0"
  Mod4 + Control + Left
"bspc node -z right 20 0 || bspc node -z left 20 0"
  Mod4 + Control + Right
"bspc node -z top 0 -20 || bspc node -z bottom 0 -20"
  Mod4 + Control + Up
"bspc node -z bottom 0 20 || bspc node -z top 0 20"
  Mod4 + Control + Down

"bspc desktop -f next"
  Mod4 + Next
"bspc desktop -f prev"
  Mod4 + Prior
"bspc node -d next --follow"
  Mod4 + Shift + Next
"bspc node -d prev --follow"
  Mod4 + Shift + Prior
