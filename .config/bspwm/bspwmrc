#!/bin/sh

# desktops
bspc monitor -d 1 2 3 4 5 6 7 8 9

# look
bspc config border_width         2
bspc config window_gap           2
bspc config split_ratio          0.55
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config bottom_padding 15

# focus
bspc config focus_follows_pointer false

# rules
bspc rule -a mGBA state=floating
bspc rule -a org.dosbox_staging.dosbox_staging state=floating
bspc rule -a Snes9x-gtk state=floating
bspc rule -a pwcview state=floating
bspc rule -a lumina-calculator state=floating
bspc rule -a micropolisj-Micropolis state=floating
bspc rule -a fbsd-duckstation-qt state=floating
bspc rule -a Netsurf-gtk state=floating
bspc rule -a XCalendar state=floating
bspc rule -a Java state=floating
bspc rule -a feh state=floating
bspc rule -a Xarchiver state=floating
bspc rule -a librewolf desktop='^2' follow=on
bspc rule -a qutebrowser desktop='^2' follow=on
bspc rule -a tor-browser desktop='^2' follow=on
bspc rule -a mpv desktop='^5' follow=on
bspc rule -a soffice.bin desktop='^4' follow=on
bspc rule -a Claws-mail desktop='^6' follow=on
bspc rule -a codium desktop='^7' follow=on
bspc rule -a code-oss desktop='^7' follow=on

